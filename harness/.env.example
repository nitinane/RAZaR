# ==============================================================================
# Revenue Recovery Agent & Decision Harness — Environment Variables Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ── 1. REQUIRED: Supabase Credentials ─────────────────────────────────────────
# Required for persisting failed_payments and the DAG decision harness_nodes.
# Project Settings → API → Project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Project Settings → API → Project API Keys → service_role (Secret Key)
# WARNING: The service-role key bypasses Row-Level Security (RLS) for backend execution.
# NEVER expose this key in the frontend or client-side bundles.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<your-service-role-key>

# ── 2. REQUIRED: Groq API Key ─────────────────────────────────────────────────
# Required for live LLM diagnosis (openai/gpt-oss-20b & openai/gpt-oss-120b)
# and Action Decision agents. Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_<your-groq-api-key>

# ── 3. OPTIONAL: Razorpay Test-Mode Credentials ──────────────────────────────
# Used by the Execution Agent when attempting live test collection retries.
# If omitted or test keys fail, the execution agent falls back to simulation mode.
RAZORPAY_KEY_ID=rzp_test_<your-test-key-id>
RAZORPAY_KEY_SECRET=<your-test-key-secret>
